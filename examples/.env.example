# Copy to .env locally; never commit the populated file.
TZ=UTC
HOSTNAME=home-server
DOMAIN=server.example
LAN_ADDRESS=192.168.1.50
DATA_ROOT=/mnt/data
APP_ROOT=/srv/app-data
BACKUP_REMOTE=backup:example-bucket
PUID=1000
PGID=1000
IMMICH_VERSION=<PINNED_VERSION>
JELLYFIN_IMAGE=<PINNED_IMAGE>
PIHOLE_PASSWORD=CHANGE_ME_IN_PASSWORD_MANAGER
PAPERLESS_DB_PASSWORD=CHANGE_ME_IN_PASSWORD_MANAGER
DB_PASSWORD=CHANGE_ME_IN_PASSWORD_MANAGER
DB_USERNAME=CHANGE_ME
DB_DATABASE_NAME=immich
BESZEL_AGENT_TOKEN=CHANGE_ME_IN_PASSWORD_MANAGER
BESZEL_AGENT_KEY=CHANGE_ME_IN_PASSWORD_MANAGER
DATA_DEVICE_1=/dev/disk/by-id/<data-disk-1>
DATA_DEVICE_2=/dev/disk/by-id/<data-disk-2>
